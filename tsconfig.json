{
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "./src/",
    "outDir": "./lib/",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "target": "es6",
    "jsx": "react",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"],
}
